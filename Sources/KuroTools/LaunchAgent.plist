<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.kuro.kurotools.app</string>
  <key>ProgramArguments</key><array><string>/Applications/KuroTools.app/Contents/MacOS/KuroTools</string></array>
  <key>RunAtLoad</key><true/>
  <!-- Chỉ khởi động lại khi crash; Quit từ menu thì ở yên đó. -->
  <key>KeepAlive</key><dict><key>SuccessfulExit</key><false/></dict>
  <key>ThrottleInterval</key><integer>10</integer>
</dict>
</plist>
